.gradle
**/build/
!src/**/build/
run/
out/
bin/
# Only benchmark documentation is published. Other docs stay local.
/docs/*
!/docs/benchmarks/

# Runtime logs stay local.
/logs/
test-fixtures/

# Keep local benchmark tools, reports and raw measurement data out of new commits.
/benchmarks/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# IDEA config
.idea

# Pulsar Colored Lighting Addon
pcla/
