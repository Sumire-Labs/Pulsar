.gradle
**/build/
!src/**/build/
run/
out/
bin/
docs/research/
test-fixtures/

# Keep local benchmark tools, reports and raw measurement data out of new commits.
/benchmarks/
/docs/benchmarks/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# IDEA config
.idea

# Pulsar Colored Lighting Addon
pcla/
