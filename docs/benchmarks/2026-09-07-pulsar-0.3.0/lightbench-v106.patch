+    /** Run ordinary deferred sky-gap maintenance; never write lighting values or readiness flags. */
+    private void drainVanillaSkyGaps(final BlockPos position) throws IllegalAccessException {
+        final List<Chunk> chunks = new ArrayList<>();
+        if (position == null) {
+            for (final Chunk chunk :
+                    ((WorldServer) this.vanillaWorld).getChunkProvider().getLoadedChunks()) {
+                // Ignore unrelated boundary chunks whose ordinary tick cannot run without its halo.
+                if (this.vanillaWorld.isAreaLoaded(new BlockPos(chunk.x * 16 + 8, 0, chunk.z * 16 + 8), 16, false)) {
+                    chunks.add(chunk);
+                }
+            }
+        } else {
+            for (int x = (position.getX() >> 4) - 1; x <= (position.getX() >> 4) + 1; ++x) {
+                for (int z = (position.getZ() >> 4) - 1; z <= (position.getZ() >> 4) + 1; ++z) {
+                    final Chunk chunk = this.vanillaWorld.getChunkProvider().getLoadedChunk(x, z);
+                    if (chunk == null)
+                        throw new IllegalStateException("missing update completion halo: " + x + "," + z);
+                    chunks.add(chunk);
+                }
+            }
+        }
+        for (int pass = 0; pass < 8; ++pass) {
+            boolean pending = false;
+            for (final Chunk chunk : chunks) {
+                if (this.vanillaGapPending.getBoolean(chunk)) {
+                    pending = true;
+                    chunk.onTick(false);
+                }
+            }
+            if (!pending) return;
+        }
+        throw new IllegalStateException("vanilla sky-gap maintenance did not settle in 8 passes");
+    }
