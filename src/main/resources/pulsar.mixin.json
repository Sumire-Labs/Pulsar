{
  "required": true,
  "package": "com.sumirelabs.pulsar.mixin",
  "compatibilityLevel": "JAVA_25",
  "target": "@env(DEFAULT)",
  "mixins": [
    "MixinBlockFaceLight",
    "MixinBlockSlabFaceLight",
    "MixinBlockStairsFaceLight",
    "MixinBlockStateImplementation",
    "MixinChunk",
    "MixinChunkSectionChanges",
    "MixinChunkVanillaLighting",
    "MixinSPacketChunkData",
    "MixinWorld",
    "MixinWorldEntitySpawner"
  ],
  "client": [
    "MixinBlockModelRendererLight",
    "MixinBlockRenderLight",
    "MixinCeleritasWorldSlice",
    "MixinChunkCacheRenderLight",
    "MixinRenderJSONPaintingLight",
    "MixinRenderPaintingLight",
    "MixinWorldRenderLight"
  ],
  "server": [
    "MixinPlayerChunkMapEntry",
    "MixinWorldServer"
  ],
  "setSourceFile": true,
  "minVersion": "0.8.7",
  "injectors": {
    "defaultRequire": 1
  }
}
